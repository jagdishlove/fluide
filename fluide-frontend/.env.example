# REQUIRED env vars for the frontend.
# Set these in Vercel (Project Settings -> Environment Variables) for production,
# and in a local .env.development file for local dev.
# There are NO hardcoded defaults in the code.

# API base URL (no trailing slash). REQUIRED.
REACT_APP_API_URL=

# WebSocket URL for streaming (description / examples / ask-question).
# OPTIONAL: if not set, it is derived from REACT_APP_API_URL (https -> wss).
# Set it explicitly only if the WebSocket runs on a different host/port than the API.
REACT_APP_WS_URL=
